@startuml C4_DataPipeline
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4-нотация, уровень Container - пайплайн данных GoFuture: микросервисы -> ML-платформа и BI

' ===================== ИСТОЧНИКИ =====================
System_Boundary(sources, "Источники данных") {
    Container(services, "Доменные сервисы", "микросервисы", "Порождают бизнес-данные и доменные события")
    ContainerDb(outbox, "Outbox сервисов", "PostgreSQL", "События в одной транзакции с данными")
}

' ===================== СБОР И ТРАНСПОРТ =====================
System_Boundary(ingest, "Сбор и транспорт") {
    Container(cdc, "CDC", "Debezium", "Публикует изменения из outbox")
    Container(kafka, "Шина событий", "Kafka", "Единый поток доменных событий по регионам")
    Container(sr, "Schema Registry", "реестр схем", "Схемы событий и совместимость")
}

' ===================== ОБРАБОТКА =====================
System_Boundary(processing, "Обработка") {
    Container(flink, "Потоковая обработка", "Flink", "Нормализация, обогащение, агрегаты реального времени")
    Container(spark, "Пакетная обработка", "Spark", "Витрины, исторические признаки, пересчёты")
    Container(airflow, "Оркестрация", "Airflow", "Расписание пакетных задач")
}

' ===================== ХРАНЕНИЕ =====================
System_Boundary(storage, "Хранение") {
    ContainerDb(lake, "Озеро данных", "объектное хранилище", "Сырые данные и большие объёмы")
    ContainerDb(dwh, "Хранилище аналитики", "ClickHouse", "Быстрые витрины")
    ContainerDb(features, "Витрина признаков", "хранилище признаков", "Единый расчёт признаков для ML")
}

' ===================== ML-ПЛАТФОРМА =====================
System_Boundary(ml, "ML-платформа") {
    Container(train, "Обучение моделей", "ML-конвейер", "Цены, прогноз спроса, фрод")
    Container(registry, "Реестр моделей", "хранилище моделей", "Версии и метаданные моделей")
    Container(inference, "Онлайн-инференс", "сервис моделей", "Предсказания для продуктовых сервисов")
}

' ===================== BI =====================
System_Boundary(bi, "BI") {
    Container(datalens, "DataLens", "BI", "Дашборды и отчёты")
}

' ===================== КАЧЕСТВО ДАННЫХ =====================
System_Boundary(dq, "Качество данных") {
    Container(checks, "Проверки качества", "валидация", "Полнота, уникальность, диапазоны, своевременность")
    ContainerDb(quarantine, "Зона отбраковки", "хранилище", "Записи, не прошедшие проверки")
    Container(catalog, "Происхождение данных и каталог", "реестр данных", "Откуда данные и как преобразованы")
}

' ===================== ПОТРЕБИТЕЛИ =====================
Person(analyst, "Аналитик", "Смотрит отчёты и дашборды")
Person(ds, "Дата-инженер", "Ведёт пайплайн и качество данных")

' ===================== СВЯЗИ =====================
Rel(services, outbox, "Пишут события", "SQL")
Rel(outbox, cdc, "Читает изменения", "CDC")
Rel(cdc, kafka, "Публикует события", "Kafka")
Rel(kafka, sr, "Проверка схем", "API")
Rel(services, sr, "Регистрируют схемы событий", "API")

Rel(kafka, flink, "Поток событий", "Kafka")
Rel(flink, dwh, "Агрегаты реального времени", "SQL")
Rel(kafka, lake, "Сырые данные", "потоковая выгрузка")
Rel(lake, spark, "Читает данные", "Spark")
Rel(airflow, spark, "Запускает задачи", "расписание")
Rel(spark, dwh, "Строит витрины", "SQL")
Rel(spark, features, "Считает признаки", "запись")

Rel(features, train, "Признаки для обучения", "чтение")
Rel(train, registry, "Регистрирует модели", "API")
Rel(registry, inference, "Загружает модель", "API")
Rel(inference, services, "Предсказания (цена, спрос, фрод)", "API/события")

Rel(dwh, datalens, "Витрины", "SQL")
Rel(analyst, datalens, "Смотрит дашборды")

Rel(kafka, checks, "Проверки на входе", "поток")
Rel(flink, checks, "Проверки после обработки", "события")
Rel(spark, checks, "Проверки перед витринами", "задачи")
Rel(checks, quarantine, "Отбракованные записи", "запись")
Rel(checks, catalog, "Регистрация происхождения", "метаданные")
Rel(ds, checks, "Настраивает проверки")
Rel(ds, catalog, "Ведёт каталог данных")

SHOW_LEGEND()

note right of ml
  ML-платформа строит модели динамического
  ценообразования, прогноза спроса и
  обнаружения мошенничества на общей витрине
  признаков; результаты возвращаются в сервисы.
end note

note bottom of dq
  Качество данных: контракты и схемы,
  проверки на каждом слое, зона отбраковки,
  происхождение данных, мониторинг метрик.
end note

@enduml
