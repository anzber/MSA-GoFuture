@startuml GeoRouting
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Схема геомаршрутизации пользователей (изменения красным)

AddElementTag("new", $bgColor="#FADBD8", $fontColor="#7B241C", $borderColor="#C0392B")
AddRelTag("new", $lineColor="#C0392B", $textColor="#7B241C")

Person(passenger, "Пассажир", "Пользуется приложением")
Person(driver, "Водитель", "Пользуется приложением")

System_Boundary(global, "Глобальный вход") {
    Container(dns, "Глобальный DNS", "география + задержка", "Отдаёт адрес ближайшего здорового региона", $tags="new")
    ContainerDb(health, "Проверки здоровья", "Health checks", "Состояние регионов и площадок", $tags="new")
    Container(home, "Определение домашней юрисдикции", "сервис", "Страна пользователя -> домашняя юрисдикция (два региона) для персональных данных", $tags="new")
    Container(piiprox, "Межрегиональный прокси PII", "mTLS", "Проксирует операции с персональными данными в домашний регион", $tags="new")
}

System_Boundary(regions, "Юрисдикции и регионы (4 / 7, одновременно активные)") {
    Container(ing_ru, "Вход: Регион 1 (РФ)", "DDoS + WAF + балансировщик + API Gateway", "Приём трафика региона РФ")
    Container(ing_ru2, "Вход: Регион 2 (РФ)", "DDoS + WAF + балансировщик + API Gateway", "Второй регион РФ", $tags="new")
    Container(ing_id, "Вход: Регион 1 (Индонезия)", "DDoS + WAF + балансировщик + API Gateway", "Основной регион Индонезии", $tags="new")
    Container(ing_id2, "Вход: Регион 2 (Индонезия)", "DDoS + WAF + балансировщик + API Gateway", "Второй регион Индонезии", $tags="new")
    Container(ing_br, "Вход: Регион 1 (Бразилия)", "DDoS + WAF + балансировщик + API Gateway", "Основной регион Бразилии", $tags="new")
    Container(ing_br2, "Вход: Регион 2 (Бразилия)", "DDoS + WAF + балансировщик + API Gateway", "Второй регион Бразилии", $tags="new")
    Container(ing_sg, "Вход: Регион 1 (Сингапур)", "DDoS + WAF + балансировщик + API Gateway", "Город-государство: единственный регион", $tags="new")
    Container(svc, "Доменные сервисы региона", "микросервисы", "Booking, Driver, Pricing, Payments и др.")
}

Rel(passenger, dns, "Разрешает имя", "DNS")
Rel(driver, dns, "Разрешает имя", "DNS")
Rel(health, dns, "Состояние регионов", "проверки здоровья", $tags="new")

Rel(dns, ing_ru, "Ближайший/домашний регион", "маршрутизация", $tags="new")
Rel(dns, ing_ru2, "Ближайший/домашний регион", "маршрутизация", $tags="new")
Rel(dns, ing_id, "Ближайший/домашний регион", "маршрутизация", $tags="new")
Rel(dns, ing_id2, "Ближайший/домашний регион", "маршрутизация", $tags="new")
Rel(dns, ing_br, "Ближайший/домашний регион", "маршрутизация", $tags="new")
Rel(dns, ing_br2, "Ближайший/домашний регион", "маршрутизация", $tags="new")
Rel(dns, ing_sg, "Ближайший/домашний регион", "маршрутизация", $tags="new")

Rel(ing_ru, home, "Домашняя юрисдикция", "запрос", $tags="new")
Rel(ing_ru2, home, "Домашняя юрисдикция", "запрос", $tags="new")
Rel(ing_id, home, "Домашняя юрисдикция", "запрос", $tags="new")
Rel(ing_id2, home, "Домашняя юрисдикция", "запрос", $tags="new")
Rel(ing_br, home, "Домашняя юрисдикция", "запрос", $tags="new")
Rel(ing_br2, home, "Домашняя юрисдикция", "запрос", $tags="new")
Rel(ing_sg, home, "Домашняя юрисдикция", "запрос", $tags="new")

' Пример: пользователь вошёл через регион другой юрисдикции, домашняя юрисдикция - РФ
Rel(ing_sg, piiprox, "Операции с PII", "mTLS", $tags="new")
Rel(piiprox, ing_ru, "Проксирование в домашний регион юрисдикции", "mTLS", $tags="new")

Rel(ing_ru, svc, "Запросы", "HTTP/gRPC")
Rel(ing_ru2, svc, "Запросы", "HTTP/gRPC")
Rel(ing_id, svc, "Запросы", "HTTP/gRPC")
Rel(ing_id2, svc, "Запросы", "HTTP/gRPC")
Rel(ing_br, svc, "Запросы", "HTTP/gRPC")
Rel(ing_br2, svc, "Запросы", "HTTP/gRPC")
Rel(ing_sg, svc, "Запросы", "HTTP/gRPC")

SHOW_LEGEND()

note right of dns
  **Правило маршрутизации**
  1) Обычные операции - в ближайший здоровый регион.
  2) Операции с персональными данными - в домашнюю юрисдикцию пользователя.
  3) При отказе региона домашней юрисдикции - во второй регион той же юрисдикции
     (персональные данные доступны); соседний регион другой страны - только для
     некритичных операций.
end note

note bottom of home
  Домашняя юрисдикция определяется по стране пользователя
  и хранится в его профиле (в регионе).
  Если пользователь путешествует: обычные операции идут
  в ближайший регион, персональные - в домашнюю юрисдикцию.
end note

note bottom of piiprox
  **Путь запроса с персональными данными**
  Регион входа по токену/профилю определяет домашний регион
  и проксирует PII-запрос в его вход по приватному каналу (mTLS).
  На схеме показан пример: вход другой юрисдикции -> домашний Регион 1 РФ;
  для любого другого входа действует то же правило.
end note

@enduml
