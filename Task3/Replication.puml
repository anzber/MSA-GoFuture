@startuml Replication
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Схема репликации данных: 4 юрисдикции / 7 регионов (изменения красным)

AddElementTag("new", $bgColor="#FADBD8", $fontColor="#7B241C", $borderColor="#C0392B")
AddRelTag("new", $lineColor="#C0392B", $textColor="#7B241C")

System_Boundary(global, "Общий слой") {
    ContainerDb(g_ref, "Мастер справочных данных", "PostgreSQL", "Тарифы, конфигурация, каталог партнёров; единственный владелец записи", $tags="new")
    ContainerDb(g_analytics, "Общий аналитический слой", "ClickHouse", "Обезличенные агрегаты со всех регионов", $tags="new")
    Container(g_iam, "Идентификация", "IAM", "Только неперсональные идентификаторы и учётные данные; ПД - в домашней юрисдикции", $tags="new")
}

System_Boundary(jur_ru, "Юрисдикция: РФ") {
    Container(ru, "Регион 1 (РФ)", "регион", "Шлюз + шина + БД + аналитика; ПД резидентов РФ")
    Container(ru2, "Регион 2 (РФ)", "регион", "Второй регион юрисдикции; синхронная копия ПД", $tags="new")
}

System_Boundary(jur_id, "Юрисдикция: Индонезия") {
    Container(id, "Регион 1 (Индонезия)", "регион", "ПД резидентов Индонезии", $tags="new")
    Container(id2, "Регион 2 (Индонезия)", "регион", "Второй регион юрисдикции; синхронная копия ПД", $tags="new")
}

System_Boundary(jur_br, "Юрисдикция: Бразилия") {
    Container(br, "Регион 1 (Бразилия)", "регион", "ПД резидентов Бразилии", $tags="new")
    Container(br2, "Регион 2 (Бразилия)", "регион", "Второй регион юрисдикции; синхронная копия ПД", $tags="new")
}

System_Boundary(jur_sg, "Юрисдикция: Сингапур") {
    Container(sg, "Регион 1 (Сингапур)", "регион", "Единственный регион: второго внутри страны нет", $tags="new")
}

' Справочные данные: из мастера во все регионы (только чтение)
Rel(g_ref, ru, "Репликация справочных данных", "логическая репликация", $tags="new")
Rel(g_ref, ru2, "Репликация справочных данных", "логическая репликация", $tags="new")
Rel(g_ref, id, "Репликация справочных данных", "логическая репликация", $tags="new")
Rel(g_ref, id2, "Репликация справочных данных", "логическая репликация", $tags="new")
Rel(g_ref, br, "Репликация справочных данных", "логическая репликация", $tags="new")
Rel(g_ref, br2, "Репликация справочных данных", "логическая репликация", $tags="new")
Rel(g_ref, sg, "Репликация справочных данных", "логическая репликация", $tags="new")

' Идентификация: реплики во все регионы
Rel(g_iam, ru, "Реплики учётных записей", "репликация", $tags="new")
Rel(g_iam, ru2, "Реплики учётных записей", "репликация", $tags="new")
Rel(g_iam, id, "Реплики учётных записей", "репликация", $tags="new")
Rel(g_iam, id2, "Реплики учётных записей", "репликация", $tags="new")
Rel(g_iam, br, "Реплики учётных записей", "репликация", $tags="new")
Rel(g_iam, br2, "Реплики учётных записей", "репликация", $tags="new")
Rel(g_iam, sg, "Реплики учётных записей", "репликация", $tags="new")

' Обезличенные агрегаты: из регионов в общий слой
Rel(ru, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")
Rel(ru2, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")
Rel(id, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")
Rel(id2, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")
Rel(br, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")
Rel(br2, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")
Rel(sg, g_analytics, "Обезличенные агрегаты", "поток событий", $tags="new")

' Синхронная репликация ПД внутри юрисдикции (между двумя регионами)
Rel(ru, ru2, "Синхронная репликация ПД", "репликация", $tags="new")
Rel(id, id2, "Синхронная репликация ПД", "репликация", $tags="new")
Rel(br, br2, "Синхронная репликация ПД", "репликация", $tags="new")

SHOW_LEGEND()

note bottom of jur_ru
  **Персональные данные не покидают юрисдикцию**
  ПД хранятся в домашней стране и синхронно реплицируются между двумя её регионами.
  Бизнес-топики Kafka зеркалируются односторонне primary -> standby (MM2, sync offsets).
  Между разными юрисдикциями идут только справочные данные и обезличенные агрегаты.
end note

note top of g_ref
  **Один владелец записи**
  Запись справочных данных - только в мастере; регионы получают реплики только для чтения.
end note

note bottom of jur_sg
  **Исключение: город-государство**
  Второго региона внутри Сингапура нет, поэтому отказ региона Сингапур равен потере
  юрисдикции (принятое отклонение, см. ADR-004, сценарий 10).
end note

@enduml
