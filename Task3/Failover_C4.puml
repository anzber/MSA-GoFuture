@startuml Failover_C4
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Аварийное переключение (failover): отказ региона внутри юрисдикции (изменения красным)

AddElementTag("new", $bgColor="#FADBD8", $fontColor="#7B241C", $borderColor="#C0392B")
AddRelTag("new", $lineColor="#C0392B", $textColor="#7B241C")

Person(users, "Пользователи", "Пассажиры и водители")

System_Boundary(entry, "Глобальный вход") {
    Container(dns, "Глобальный DNS", "маршрутизация + проверки здоровья", "Направляет трафик в здоровый регион")
    Container(dns_b, "Резервный DNS", "аварийный вход", "Статические записи на случай отказа основного DNS", $tags="new")
}

System_Boundary(quorum, "Кворумный домен (независимый, вне обоих регионов; ПД не хранит)") {
    Container(witness, "Свидетель кворума", "witness", "Не хранит ПД; даёт кворум 2 из 3 при переключении", $tags="new")
}

System_Boundary(jur, "Домашняя юрисдикция (два региона)") {
    System_Boundary(regA, "Регион A (основной)") {
        Container(gwA, "API Gateway региона A", "шлюз", "Вход трафика региона")
        ContainerDb(dbA, "БД региона A (primary)", "PostgreSQL", "Мастер-запись региона")
        Container(kafkaA, "Шина событий региона A", "Kafka", "Топики региона")
    }
    System_Boundary(regA2, "Регион A2 (второй регион; синхронный standby)") {
        Container(gwA2, "API Gateway региона A2", "шлюз", "Принимает трафик и запись при отказе A", $tags="new")
        ContainerDb(dbA2, "БД региона A2 (синхронная реплика ПД)", "PostgreSQL", "Синхронная копия персональных данных", $tags="new")
        Container(kafkaA2, "Шина событий региона A2", "Kafka", "Топики региона", $tags="new")
    }
}

System_Boundary(regB, "Регион B (соседняя юрисдикция; только некритичные операции)") {
    Container(gwB, "API Gateway региона B", "шлюз", "Некритичные (не персональные) операции при отказе A")
    ContainerDb(dbB, "БД региона B", "PostgreSQL", "Данные региона B")
    Container(kafkaB, "Шина событий региона B", "Kafka", "Топики региона")
}

System_Ext(psp, "Основной платёжный провайдер", "PSP")
System_Ext(psp_b, "Резервный платёжный провайдер", "PSP", $tags="new")

' Пользователи и вход
Rel(users, dns, "Обращаются", "DNS")
Rel(dns, gwA, "Основной регион", "маршрутизация")
Rel(dns, gwA2, "При отказе региона A (персональные данные)", "маршрутизация", $tags="new")
Rel(dns, gwB, "Некритичные операции при отказе A", "маршрутизация", $tags="new")
Rel(dns_b, dns, "Аварийное переключение", "резервный вход", $tags="new")

' Переключение внутри юрисдикции (второй регион)
Rel(dbA, dbA2, "Синхронная репликация ПД", "репликация", $tags="new")
Rel(dbA2, dbA, "Повышение реплики при отказе региона A", "переключение", $tags="new")
Rel(witness, dbA, "Кворум 2 из 3 при переключении", "голосование", $tags="new")
Rel(witness, dbA2, "Кворум 2 из 3 при переключении", "голосование", $tags="new")

' Шина событий
Rel(kafkaA, kafkaA2, "Зеркалирование бизнес-топиков: primary -> standby (MM2, sync offsets)", "репликация", $tags="new")

' Платёжный провайдер
Rel(gwA, psp, "Платежи", "REST")
Rel(gwA, psp_b, "При отказе основного PSP", "переключение", $tags="new")

SHOW_LEGEND()

note right of dns
  **Проверки здоровья**
  Регион считается нездоровым при недоступности входа
  или БД; глобальный DNS убирает его из ответов.
end note

note bottom of jur
  **Отказ региона**
  - Трафик и запись переключаются на второй регион A2 **той же юрисдикции**
    (синхронная реплика ПД, RPO=0, простой секунды-минуты).
  - Соседний регион B другой юрисдикции принимает только некритичные
    (не персональные) операции.
  - Полная потеря юрисдикции (A и A2 разом) - катастрофа: восстановление
    из резервных копий (см. ADR-004).
end note

note bottom of regA2
  Второй регион юрисдикции - полноценный: шлюз, шина событий и БД.
  Заменяет регион A при его отказе, а не является простой репликой.
end note

note bottom of psp_b
  **Внешние зависимости**
  При недоступности основного платёжного провайдера платежи
  уходят в очередь и повторяются через резервного провайдера;
  повторы идемпотентны (без двойных списаний).
end note

@enduml
